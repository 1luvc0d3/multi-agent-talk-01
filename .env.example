# Copy to .env and fill in. Never commit the real .env.
#
# Works with any OpenAI-compatible endpoint. Pick whichever free tier you can get:
#
# OpenAI
#   BASE_URL=https://api.openai.com/v1
#   MODEL=gpt-4o-mini
#
# Google Gemma, hosted (OpenAI-compatible endpoint, key from aistudio.google.com)
#   BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL=gemma-4-31b-it
#
# Groq
#   BASE_URL=https://api.groq.com/openai/v1
#   MODEL=llama-3.3-70b-versatile
#
# Ollama, running on your own machine, no key needed (use any string as API_KEY)
#   BASE_URL=http://localhost:11434/v1
#   MODEL=gemma3

API_KEY=your-key-here
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
